{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TCP Latency",
  "version": "0.13.0",
  "identifier": "com.hutong.tcplatency",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TCP Latency",
        "url": "index.html",
        "width": 228,
        "height": 100,
        "minWidth": 178,
        "minHeight": 76,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "TCP Latency 设置",
        "url": "settings.html",
        "width": 760,
        "height": 860,
        "minWidth": 680,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "macOS TCP latency and live network traffic monitor with frosted HUD",
    "longDescription": "A lightweight macOS menu bar network monitor with TCP latency, live upload/download traffic, native AppKit window behavior, frosted glass HUD, multi-target probing, diagnostics, alerts, Network Cat themes and mouse passthrough.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
